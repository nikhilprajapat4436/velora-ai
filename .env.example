PORT=5000
NODE_ENV=development

# Database and authentication
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/<database>
JWT_SECRET=replace-with-a-long-random-secret

# Required AI providers
GROQ_API_KEY=your-groq-api-key
CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id
CLOUDFLARE_API_TOKEN=your-workers-ai-api-token
# Optional; defaults to Cloudflare Stable Diffusion XL
# CLOUDFLARE_IMAGE_MODEL=@cf/stabilityai/stable-diffusion-xl-base-1.0

# Optional integrations
GOOGLE_CLIENT_ID=your-google-oauth-client-id
VITE_GOOGLE_CLIENT_ID=your-google-oauth-client-id
TAVILY_API_KEY=your-tavily-api-key
SEARXNG_URL=http://localhost:8080


# Only needed when the frontend is hosted on a different origin than the API.
# Separate multiple origins with commas; do not add a trailing slash.
# CORS_ORIGINS=https://your-frontend.example.com

# For a separately hosted frontend, set this at frontend build time.
# VITE_API_URL=https://your-api.example.com
